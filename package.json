{
  "name": "nightout",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-constants": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.16",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "pg-query-emscripten": "^5.1.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "db:generate-seed": "tsx scripts/generate-seed-sql.ts && node scripts/lint-sql.mjs",
    "db:push": "supabase db push",
    "db:seed": "supabase db query --linked -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --project-id wfrgebdwbddhitjvqrhl > src/lib/database.types.ts",
    "db:lint": "node scripts/lint-sql.mjs",
    "build:web": "expo export --platform web",
    "eas:init": "eas init",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:ios": "eas build --profile preview --platform ios",
    "eas:update": "eas update --branch preview"
  },
  "private": true
}
