# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle at build time.
# That is correct for these two: the project URL and the publishable key are
# designed to ship in a client, and the database is protected by row-level
# security rather than by keeping them secret.

EXPO_PUBLIC_SUPABASE_URL=https://wfrgebdwbddhitjvqrhl.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> publishable key
# (starts with sb_publishable_). The legacy anon JWT also works.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Google Maps (src/components/MiniMap.web.tsx / MiniMap.native.tsx). Three
# separate keys, because each platform's Google Maps SDK is billed and
# restricted separately -- one key per platform, never a shared one. All
# three come from the same Google Cloud project: console.cloud.google.com ->
# APIs & Services -> Credentials -> Create credentials -> API key, after
# enabling the matching API below. Google Maps Platform requires a billing
# account on the project (a recurring monthly credit covers normal
# development/demo use, but it is not a free-forever key the way the
# Supabase publishable key above is).
#
# Web key: enable "Maps JavaScript API", then restrict the key to
# HTTP referrers (your dev server origin and any deployed domain). This one
# IS prefixed EXPO_PUBLIC_ on purpose -- a Maps JS API key is designed to
# ship inside a web page; the HTTP-referrer restriction is what actually
# protects it, not secrecy.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# iOS key: enable "Maps SDK for iOS", then restrict the key to this app's
# bundle identifier (io.linqx.nightout). Read only by app.config.ts at
# `expo prebuild` time to generate native iOS config -- never shipped in the
# JS bundle, so it is not EXPO_PUBLIC_.
GOOGLE_MAPS_IOS_API_KEY=

# Android key: enable "Maps SDK for Android", then restrict the key to this
# app's package name (io.linqx.nightout) and your signing certificate's
# SHA-1 fingerprint. Same as the iOS key: read only at prebuild time.
GOOGLE_MAPS_ANDROID_API_KEY=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Do NOT put the service role key in this file or in any EXPO_PUBLIC_ variable.
#
# It bypasses row-level security completely. Anything prefixed EXPO_PUBLIC_ ends
# up readable inside the shipped app bundle, so a service role key placed there
# would hand every user full read and write access to the whole database.
#
# It belongs in .env.local (also gitignored), and only for local admin scripts:
#
#   SUPABASE_SERVICE_ROLE_KEY=...
# ---------------------------------------------------------------------------
